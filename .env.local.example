# ---------------------------------------------------------------------------
# Recipe Book environment variables
#
# Local dev:   copy to .env.local and fill in.
# cPanel/prod: set these in the "Setup Node.js App" Environment variables panel.
#              NEXT_PUBLIC_* values are inlined at BUILD time, so they MUST be
#              present before you run `npm run build` on the server.
# Do NOT wrap values in quotes.
# ---------------------------------------------------------------------------

# Supabase (auth + storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database — Supabase Postgres connection string used by the pg pool at runtime.
# Use the pooled (pgbouncer) connection string here.
DATABASE_URL=
# Direct (non-pooled) connection — used by `prisma migrate deploy`.
DIRECT_URL=

# AI recipe structuring
ANTHROPIC_API_KEY=

# Optional: external fetch proxy for blog scraping (e.g. ScraperAPI). Leave
# blank to fetch pages directly.
SCRAPER_API_KEY=

# Optional: per-user daily extraction cap
RATE_LIMIT_DAILY=20

# Production runtime
NODE_ENV=production
# Skip Playwright's ~150MB Chromium download during install on cPanel.
# (Social/video extraction needs a real browser and won't run on shared
# hosting; the blog-URL importer does not need it.)
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
